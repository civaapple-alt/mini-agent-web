# Web Studio / Gateway deployment settings
# Copy this file to .env only when you need to override a default.

# Gateway listener. The defaults are 0.0.0.0:8000.
# MINI_AGENT_HOST=0.0.0.0
# MINI_AGENT_PORT=8000
# MINI_AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App Server executable. Leave unset when mini-agent-app-server is on PATH.
# MINI_AGENT_APP_SERVER_PATH=/absolute/path/to/mini-agent-app-server

# Gateway-to-SDK service logs.
# MINI_AGENT_LOG_DIR=logs
# MINI_AGENT_LOG_FILE=
# MINI_AGENT_LOG_LEVEL=INFO
# MINI_AGENT_LOG_MODE=a

# Advanced Goal safety ceilings. Defaults: 100 loops, 200 steps per milestone,
# and 1800 seconds per milestone. Everyday Goal behavior uses these limits.
# MINI_AGENT_GOAL_MAX_LOOPS=100
# MINI_AGENT_GOAL_STEP_BUDGET=200
# MINI_AGENT_GOAL_TIMEOUT_SECS=1800

# Model providers, API keys, and model defaults are configured in Web Studio
# under Settings > Agent capabilities > Model settings. Project model defaults
# live in Project settings. These values are owned by the Host in ~/.mini-agent.
