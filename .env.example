# ==============================================================================
# Mini Agent Web Studio / App Server Environment Configuration
# Copy this file to `.env` and fill in your API credentials:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Model Provider Configuration (OpenAI Compatible)
# ------------------------------------------------------------------------------

# Example A: DeepSeek (recommended for performance and cost efficiency)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Example B: Official OpenAI
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Example C: Zhipu GLM / Moonshot / SiliconFlow / Local vLLM / Ollama
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4-plus

# ------------------------------------------------------------------------------
# 2. Responses web_search (Optional)
# ------------------------------------------------------------------------------
# Enabled by default for supported official endpoints.
# MINI_AGENT_WEB_SEARCH=true

# ------------------------------------------------------------------------------
# 3. Goal Runtime (Optional)
# ------------------------------------------------------------------------------
# Long-running safety limits; these are not a user-facing step budget.
# Current defaults are 100 loops, 200 model steps, and 1800 seconds.
# MINI_AGENT_GOAL_MAX_LOOPS=100
# MINI_AGENT_GOAL_STEP_BUDGET=200
# MINI_AGENT_GOAL_TIMEOUT_SECS=1800

# Optional independent model for Goal verification. The verifier inherits the
# primary API key and base URL unless overridden.
# VERIFIER_OPENAI_MODEL=
# VERIFIER_OPENAI_API_KEY=
# VERIFIER_OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 4. App Server Binary Location (Optional)
# ------------------------------------------------------------------------------
# If `mini-agent-app-server` is not in your system PATH, specify its absolute path here.
# Compiled from: https://github.com/civaapple-alt/mini-codex
# Windows Example: MINI_AGENT_APP_SERVER_PATH=C:\Users\username\.tools\bin\mini-agent-app-server.exe
# Linux/macOS Example: MINI_AGENT_APP_SERVER_PATH=/usr/local/bin/mini-agent-app-server
# MINI_AGENT_APP_SERVER_PATH=

# ------------------------------------------------------------------------------
# 5. SDK Execution Logging (Optional)
# ------------------------------------------------------------------------------
# Directory where detailed JSON-RPC and process logs are saved
# MINI_AGENT_LOG_DIR=logs
# Specific log file path (overrides the generated per-run filename)
# MINI_AGENT_LOG_FILE=
# MINI_AGENT_LOG_LEVEL=DEBUG
# MINI_AGENT_LOG_MODE=a  # 'a' to append history, 'w' to overwrite/refresh each run

# Project/workspace bindings are injected by the Web Studio SessionManager.
# They are not normally configured by hand in this file:
# MINI_AGENT_PROJECT_ID=
# MINI_AGENT_EXTRA_READ_ROOTS=
# MINI_AGENT_EXTRA_WRITE_ROOTS=
